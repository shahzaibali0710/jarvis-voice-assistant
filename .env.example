# Environment variables Jarvis reads. Copy this file to see the names and where
# each value comes from -- but note: Jarvis does NOT load a .env file by itself.
# Set these as real environment variables (see "Configuration" in README.md),
# e.g. in PowerShell:
#   [Environment]::SetEnvironmentVariable("ANTHROPIC_API_KEY", "<value>", "User")
# then open a NEW terminal before starting Jarvis (running processes never see
# variables set after they started). Never commit real values.

# Required. Claude API key: https://console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Optional (Spotify). Client ID of your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
# Optional (Spotify). Client secret of the same app (dashboard -> your app -> Settings)
SPOTIFY_CLIENT_SECRET=

# Optional (Google Health). OAuth client ID: Google Cloud Console -> Google Auth Platform -> Clients -> your "Web application" client
GOOGLE_HEALTH_CLIENT_ID=
# Optional (Google Health). Client secret of that same OAuth client
GOOGLE_HEALTH_CLIENT_SECRET=

# The two below are optional overrides. They are commented out on purpose: a
# variable that is set to an empty string overrides the default instead of
# falling back to it. Uncomment and fill in only if you need to change them.

# OAuth redirect URI, if you registered a different one. Default: http://127.0.0.1:5000/health/callback
# GOOGLE_HEALTH_REDIRECT_URI=

# IANA time zone used for "today" / "last night" in health summaries. Default: Europe/Oslo
# GOOGLE_HEALTH_TIMEZONE=
